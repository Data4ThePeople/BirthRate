# Copy to .env and fill in. .env is gitignored; never commit the token.
# No quotes needed, no spaces around the '='.

# Settings > API & Security > Permanent access tokens (needs write access)
PRISMIC_TOKEN=your-permanent-token-here

# Optional. A Content API access token (the read-only kind, generated higher up
# that same settings page). Only needed for --verify, which reads a created page
# back to confirm what landed; the write token above cannot read.
PRISMIC_READ_TOKEN=

# The repository id — the subdomain of your Prismic URL,
# e.g. https://data4thepeople.prismic.io  ->  data4thepeople
PRISMIC_REPO=data4thepeople

# Run: python posts/to_prismic.py --list-types   to find this
PRISMIC_TYPE=blog_post

# Leave blank for a slice-based type such as blog_post, whose body is a slice
# zone rather than a single Rich Text field. Only set it for a type that has one.
PRISMIC_FIELD=

# Optional, defaults to en-us
PRISMIC_LANG=en-us
