# Copy to .env and fill in. .env is gitignored; never commit the token.
# No quotes needed, no spaces around the '='.

# Settings > API & Security > Permanent access tokens (needs write access)
PRISMIC_TOKEN=your-permanent-token-here

# The repository id — the subdomain of your Prismic URL,
# e.g. https://data4thepeople.prismic.io  ->  data4thepeople
PRISMIC_REPO=data4thepeople

# Run: python posts/to_prismic.py --list-types   to find these two
PRISMIC_TYPE=blog_post
PRISMIC_FIELD=content

# Optional, defaults to en-us
PRISMIC_LANG=en-us
